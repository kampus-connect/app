<const/tr=($global as any).translations ?? {}>
<const/t=(key: string, params?: Record<string, string>): string => {
  const dot = key.indexOf(".");
  const s = key.slice(0, dot);
  const k = key.slice(dot + 1);
  let v: string = (tr[s] as Record<string, string>)?.[k] ?? key;
  if (params) for (const [p, r] of Object.entries(params)) v = v.replaceAll(`{${p}}`, r);
  return v;
}>

<let/name=""/>
<let/email=""/>
<let/password=""/>
<let/skills=[{ name: "", learning: false, learning_note: "", teaching: false, teaching_note: "", doing: false, doing_note: "" }]/>
<let/errorMsg=""/>
<let/loading=false/>

<div class="auth-page">
  <div class="auth-card">
    <h1>${t("register.title")}</h1>
    <p class="sub">${t("register.subtitle")}</p>

    <if=errorMsg>
      <div class="error-banner">${errorMsg}</div>
    </if>

    <form
      class="form"
      onSubmit(e) {
        e.preventDefault();
        loading = true;
        errorMsg = "";
        fetch("/api/auth/register", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: name.trim(),
            email: email.trim(),
            password,
            skills: skills.filter((s) => s.name.trim()),
          }),
        })
          .then((r) => r.json())
          .then((data: any) => {
            if (data.error) {
              errorMsg = data.error;
              loading = false;
            } else {
              window.location.href = "/dashboard";
            }
          })
          .catch(() => {
            errorMsg = t("register.error");
            loading = false;
          });
      }
    >
      <div class="field">
        <label for="name">${t("register.fullName")}</label>
        <input
          id="name"
          type="text"
          placeholder=t("register.namePlaceholder")
          value=name
          required
          onInput(e) { name = (e.target as HTMLInputElement).value }
        />
      </div>

      <div class="field">
        <label for="email">${t("register.email")}</label>
        <input
          id="email"
          type="email"
          placeholder="alice@example.com"
          value=email
          required
          onInput(e) { email = (e.target as HTMLInputElement).value }
        />
      </div>

      <div class="field">
        <label for="password">${t("register.password")}</label>
        <input
          id="password"
          type="password"
          placeholder=t("register.passwordPlaceholder")
          value=password
          required
          onInput(e) { password = (e.target as HTMLInputElement).value }
        />
      </div>

      <fieldset class="skills-section">
        <legend>${t("skills.yourLabel")} <span class="hint">${t("skills.optional")}</span></legend>

        <for|skill, index| of=skills>
          <div class="skill-entry">
            <div class="skill-entry-header">
              <input
                type="text"
                placeholder=t("skills.placeholder")
                value=skill.name
                onInput(e) {
                  const val = (e.target as HTMLInputElement).value;
                  skills = skills.map((s, i) => (i === index ? { ...s, name: val } : s));
                }
              />
              <if=skills.length > 1>
                <button
                  type="button"
                  class="btn-remove"
                  onClick() { skills = skills.filter((_, i) => i !== index) }
                >
                  ✕
                </button>
              </if>
            </div>

            <div class="options-section">
              <span class="options-label">${t("skills.relatedOptions")}</span>

              <div class="option-group">
                <label class="option-check">
                  <input
                    type="checkbox"
                    checked=skill.learning
                    onChange(e) {
                      const val = (e.target as HTMLInputElement).checked;
                      skills = skills.map((s, i) => (i === index ? { ...s, learning: val } : s));
                    }
                  />
                  ${t("skills.learning")}
                </label>
                <if=skill.learning>
                  <textarea
                    class="option-note"
                    placeholder=t("skills.notePlaceholder")
                    onInput(e) {
                      const val = (e.target as HTMLTextAreaElement).value;
                      skills = skills.map((s, i) => (i === index ? { ...s, learning_note: val } : s));
                    }
                  >${skill.learning_note}</textarea>
                </if>
              </div>

              <div class="option-group">
                <label class="option-check">
                  <input
                    type="checkbox"
                    checked=skill.teaching
                    onChange(e) {
                      const val = (e.target as HTMLInputElement).checked;
                      skills = skills.map((s, i) => (i === index ? { ...s, teaching: val } : s));
                    }
                  />
                  ${t("skills.teaching")}
                </label>
                <if=skill.teaching>
                  <textarea
                    class="option-note"
                    placeholder=t("skills.notePlaceholder")
                    onInput(e) {
                      const val = (e.target as HTMLTextAreaElement).value;
                      skills = skills.map((s, i) => (i === index ? { ...s, teaching_note: val } : s));
                    }
                  >${skill.teaching_note}</textarea>
                </if>
              </div>

              <div class="option-group">
                <label class="option-check">
                  <input
                    type="checkbox"
                    checked=skill.doing
                    onChange(e) {
                      const val = (e.target as HTMLInputElement).checked;
                      skills = skills.map((s, i) => (i === index ? { ...s, doing: val } : s));
                    }
                  />
                  ${t("skills.doing")}
                </label>
                <if=skill.doing>
                  <textarea
                    class="option-note"
                    placeholder=t("skills.notePlaceholder")
                    onInput(e) {
                      const val = (e.target as HTMLTextAreaElement).value;
                      skills = skills.map((s, i) => (i === index ? { ...s, doing_note: val } : s));
                    }
                  >${skill.doing_note}</textarea>
                </if>
              </div>
            </div>
          </div>
        </for>

        <button
          type="button"
          class="btn-add-skill"
          onClick() { skills = [...skills, { name: "", learning: false, learning_note: "", teaching: false, teaching_note: "", doing: false, doing_note: "" }] }
        >
          ${t("skills.add")}
        </button>
      </fieldset>

      <button type="submit" class="btn-primary" disabled=loading>
        ${loading ? t("register.submitting") : t("register.submit")}
      </button>
    </form>

    <p class="switch-link">
      ${t("register.haveAccount")} <a href="/login">${t("register.signIn")}</a>
    </p>
  </div>
</div>

<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .auth-card {
    width: 100%;
    max-width: 480px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 2rem 2rem 1.75rem;
    transition: background 0.2s, border-color 0.2s;
  }

  h1 {
    margin: 0 0 0.25rem;
    font-size: 1.5rem;
    color: var(--text);
  }

  .sub {
    margin: 0 0 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .error-banner {
    background: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error-text);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  label, legend {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .hint {
    color: var(--text-dim);
    font-weight: normal;
  }

  input[type="text"],
  input[type="email"],
  input[type="password"],
  select {
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    padding: 0.6rem 0.8rem;
    font-size: 0.95rem;
    width: 100%;
    box-sizing: border-box;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  input:focus, select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .skills-section {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skill-entry {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .skill-entry:last-of-type {
    padding-bottom: 0;
    border-bottom: none;
  }

  .skill-entry-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    align-items: center;
  }

  .options-section {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 0.25rem;
  }

  .options-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .option-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .option-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text);
    cursor: pointer;
  }

  .option-check input[type="checkbox"] {
    width: auto;
    margin: 0;
    cursor: pointer;
    accent-color: var(--accent);
  }

  .option-note {
    width: 100%;
    box-sizing: border-box;
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    padding: 0.4rem 0.6rem;
    font-size: 0.85rem;
    font-family: inherit;
    resize: vertical;
    min-height: 2.5rem;
    margin-left: 1.5rem;
  }

  .option-note:focus {
    outline: none;
    border-color: var(--accent);
  }

  .btn-remove {
    background: transparent;
    border: 1px solid var(--btn-delete-border);
    color: var(--btn-delete-text);
    border-radius: 6px;
    padding: 0.5rem 0.6rem;
    cursor: pointer;
    line-height: 1;
    transition: background 0.15s;
  }

  .btn-remove:hover {
    background: var(--btn-delete-hover);
  }

  .btn-add-skill {
    align-self: flex-start;
    background: transparent;
    border: 1px dashed var(--border);
    color: var(--text-muted);
    border-radius: 8px;
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
    cursor: pointer;
    margin-top: 0.25rem;
    transition: border-color 0.15s, color 0.15s;
  }

  .btn-add-skill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.65rem;
    font-size: 1rem;
    cursor: pointer;
    width: 100%;
    margin-top: 0.25rem;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--accent-hover);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .switch-link {
    margin: 1.25rem 0 0;
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .switch-link a {
    color: var(--text-link);
    text-decoration: none;
  }

  .switch-link a:hover {
    text-decoration: underline;
  }
</style>
