<const/tr=($global as any).translations ?? {}>
<const/t=(key: string, params?: Record<string, string>): string => {
  const dot = key.indexOf(".");
  const s = key.slice(0, dot);
  const k = key.slice(dot + 1);
  let v: string = (tr[s] as Record<string, string>)?.[k] ?? key;
  if (params) for (const [p, r] of Object.entries(params)) v = v.replaceAll(`{${p}}`, r);
  return v;
}>

<const/users=($global as any).users ?? []>
<const/isAdmin=($global as any).isAdmin ?? false>
<const/allSkillsWithCounts=($global as any).allSkillsWithCounts ?? []>

<let/activeSkill=(null as string | null)>
<let/searchQuery="">

<!-- Score: 3 = starts-with, 2 = substring, 1 = subsequence, 0 = no match -->
<const/matchScore=(name: string, q: string): number => {
  if (!q) return 2;
  const n = name.toLowerCase();
  if (n.startsWith(q)) return 3;
  if (n.includes(q)) return 2;
  let qi = 0;
  for (let i = 0; i < n.length && qi < q.length; i++) if (n[i] === q[qi]) qi++;
  return qi === q.length ? 1 : 0;
}>

<!-- Split name into highlighted / plain segments for rendering -->
<const/highlightParts=(name: string, q: string): { text: string; hi: boolean }[] => {
  if (!q) return [{ text: name, hi: false }];
  const n = name.toLowerCase();

  const idx = n.indexOf(q);
  if (idx !== -1) {
    const parts: { text: string; hi: boolean }[] = [];
    if (idx > 0) parts.push({ text: name.slice(0, idx), hi: false });
    parts.push({ text: name.slice(idx, idx + q.length), hi: true });
    if (idx + q.length < name.length) parts.push({ text: name.slice(idx + q.length), hi: false });
    return parts;
  }

  // Subsequence: highlight each matched character individually
  const parts: { text: string; hi: boolean }[] = [];
  let qi = 0;
  let buf = "";
  let lastHi = false;
  for (let i = 0; i < name.length; i++) {
    const matched = qi < q.length && n[i] === q[qi];
    if (matched) qi++;
    if (matched !== lastHi && buf.length) { parts.push({ text: buf, hi: lastHi }); buf = ""; }
    buf += name[i];
    lastHi = matched;
  }
  if (buf) parts.push({ text: buf, hi: lastHi });
  return parts;
}>

<const/skillUsers=activeSkill
  ? (users as any[]).filter((u) => u.skills.some((sk: any) => sk.name === activeSkill))
  : []>

<div class="page">

  <!-- ── Skill grid view ─────────────────────────────────────── -->
  <if=activeSkill === null>
    <header class="page-header">
      <h1>${t("dashboard.title")}</h1>
    </header>

    <if=allSkillsWithCounts.length>
      <!-- Computed inside this block so reactive tracking is fresh on every remount -->
      <const/searchQ=searchQuery.toLowerCase().trim()>
      <const/displayedSkills=(allSkillsWithCounts as { name: string; count: number }[])
        .map((s) => ({ ...s, score: matchScore(s.name, searchQ) }))
        .filter((s) => s.score > 0)
        .sort((a, b) => b.score - a.score || b.count - a.count)>

      <!-- Search bar -->
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="M21 21l-4.35-4.35"/>
        </svg>
        <input
          class="search-input"
          type="text"
          placeholder=t("dashboard.searchTags")
          value=searchQuery
          autocomplete="off"
          spellcheck=false
          onInput(e) { searchQuery = (e.target as HTMLInputElement).value; }
          onKeyDown(e) { if (e.key === "Escape") searchQuery = ""; }
        />
        <if=searchQuery>
          <button
            class="search-clear"
            aria-label="Clear search"
            onClick() { searchQuery = ""; }
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </if>
      </div>

      <!-- Skill cards -->
      <if=displayedSkills.length>
        <div class="skill-grid">
          <for|skill| of=displayedSkills>
            <button class="skill-card" onClick() { activeSkill = skill.name; }>
              <span class="skill-name">
                <for|part| of=highlightParts(skill.name, searchQ)>
                  <if=part.hi>
                    <mark class="hl">${part.text}</mark>
                  </if>
                  <else>
                    ${part.text}
                  </else>
                </for>
              </span>
              <span class="skill-count">
                ${t("dashboard.userCount", { count: String(skill.count) })}
              </span>
            </button>
          </for>
        </div>
      </if>
      <else>
        <div class="empty-state">
          <p>${t("dashboard.noSkillsFound")}</p>
          <button class="clear-search-btn" onClick() { searchQuery = ""; }>
            ${t("dashboard.clearSearch")}
          </button>
        </div>
      </else>
    </if>
    <else>
      <div class="empty-state">
        <p>${t("dashboard.noUsers")}</p>
        <if=isAdmin>
          <a href="/users/create" class="btn-add">${t("dashboard.addFirst")}</a>
        </if>
      </div>
    </else>
  </if>

  <!-- ── User cards view ─────────────────────────────────────── -->
  <else>
    <header class="page-header">
      <div class="header-left">
        <button class="back-btn" onClick() { activeSkill = null; }>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          ${t("dashboard.allSkills")}
        </button>
        <h1>
          ${activeSkill}
          <span class="heading-count">${skillUsers.length}</span>
        </h1>
      </div>
    </header>

    <if=skillUsers.length>
      <div class="users-grid">
        <for|user| of=skillUsers>
          <user-card user=user isAdmin=isAdmin/>
        </for>
      </div>
    </if>
    <else>
      <div class="empty-state">
        <p>${t("dashboard.noUsers")}</p>
      </div>
    </else>
  </else>

</div>

<style>
  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  /* ── Header ─────────────────────────────────────────────────── */
  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .page-header h1 {
    margin: 0;
    font-size: 1.6rem;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .heading-count {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--border);
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.82rem;
    cursor: pointer;
    padding: 0;
    transition: color 0.15s;
  }

  .back-btn:hover { color: var(--accent); }
  .back-btn svg { width: 14px; height: 14px; }

  /* ── Search bar ──────────────────────────────────────────────── */
  .search-wrap {
    position: relative;
    margin-bottom: 1.25rem;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--text-dim);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.6rem 2.5rem 0.6rem 2.25rem;
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .search-input::placeholder { color: var(--text-dim); }

  .search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .search-clear {
    position: absolute;
    right: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: var(--border);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    color: var(--text-muted);
    padding: 0;
    transition: background 0.12s, color 0.12s;
  }

  .search-clear:hover { background: var(--surface-hover); color: var(--text); }
  .search-clear svg { width: 10px; height: 10px; }

  /* ── Skill grid ──────────────────────────────────────────────── */
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
  }

  .skill-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.1rem 1rem;
    cursor: pointer;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: border-color 0.15s, background 0.15s, transform 0.12s, box-shadow 0.12s;
  }

  .skill-card:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .skill-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Highlight matched characters */
  .hl {
    background: transparent;
    color: var(--accent);
    font-style: normal;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
    text-underline-offset: 2px;
  }

  .skill-count {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 500;
  }

  /* ── User cards grid ─────────────────────────────────────────── */
  .users-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  /* ── Empty / no-results state ────────────────────────────────── */
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .clear-search-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 8px;
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .clear-search-btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .btn-add {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.5rem 1.1rem;
    font-size: 0.9rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: background 0.15s;
  }

  .btn-add:hover { background: var(--accent-hover); color: #fff; }
</style>
