<const/tr=($global as any).translations ?? {}>
<const/t=(key: string, params?: Record<string, string>): string => {
  const dot = key.indexOf(".");
  const s = key.slice(0, dot);
  const k = key.slice(dot + 1);
  let v: string = (tr[s] as Record<string, string>)?.[k] ?? key;
  if (params) for (const [p, r] of Object.entries(params)) v = v.replaceAll(`{${p}}`, r);
  return v;
}>

<const/users=($global as any).users ?? []>
<const/isAdmin=($global as any).isAdmin ?? false>
<const/allSkillsWithCounts=($global as any).allSkillsWithCounts ?? []>

<let/activeSkill=(null as string | null)>

<const/skillUsers=activeSkill
  ? (users as any[]).filter((u) => u.skills.some((sk: any) => sk.name === activeSkill))
  : []>

<div class="page">

  <!-- ── Skill grid view ─────────────────────────────────────── -->
  <if=activeSkill === null>
    <header class="page-header">
      <h1>${t("dashboard.title")}</h1>
    </header>

    <if=allSkillsWithCounts.length>
      <div class="skill-grid">
        <for|skill| of=allSkillsWithCounts>
          <button class="skill-card" onClick() { activeSkill = skill.name; }>
            <span class="skill-name">${skill.name}</span>
            <span class="skill-count">
              ${t("dashboard.userCount", { count: String(skill.count) })}
            </span>
          </button>
        </for>
      </div>
    </if>
    <else>
      <div class="empty-state">
        <p>${t("dashboard.noUsers")}</p>
        <if=isAdmin>
          <a href="/users/create" class="btn-primary">${t("dashboard.addFirst")}</a>
        </if>
      </div>
    </else>
  </if>

  <!-- ── User cards view ─────────────────────────────────────── -->
  <else>
    <header class="page-header">
      <div class="header-left">
        <button class="back-btn" onClick() { activeSkill = null; }>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          ${t("dashboard.allSkills")}
        </button>
        <h1>
          ${activeSkill}
          <span class="heading-count">${skillUsers.length}</span>
        </h1>
      </div>
    </header>

    <if=skillUsers.length>
      <div class="users-grid">
        <for|user| of=skillUsers>
          <user-card user=user isAdmin=isAdmin/>
        </for>
      </div>
    </if>
    <else>
      <div class="empty-state">
        <p>${t("dashboard.noUsers")}</p>
      </div>
    </else>
  </else>

</div>

<style>
  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  /* ── Header ─────────────────────────────────────────────────── */
  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .page-header h1 {
    margin: 0;
    font-size: 1.6rem;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .heading-count {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--border);
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.82rem;
    cursor: pointer;
    padding: 0;
    transition: color 0.15s;
  }

  .back-btn:hover {
    color: var(--accent);
  }

  .back-btn svg {
    width: 14px;
    height: 14px;
  }

  /* ── Skill grid ──────────────────────────────────────────────── */
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
  }

  .skill-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.1rem 1rem;
    cursor: pointer;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: border-color 0.15s, background 0.15s, transform 0.12s, box-shadow 0.12s;
  }

  .skill-card:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .skill-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .skill-count {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 500;
  }

  /* ── User cards grid ─────────────────────────────────────────── */
  .users-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  /* ── Empty state ─────────────────────────────────────────────── */
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

</style>
