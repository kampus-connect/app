    nameKey: "badges.meeting.name",
    descKey: "badges.meeting.desc",
    unit: "",
  },
] as { id: string; icon: string; nameKey: string; descKey: string; unit: string }[]>

<!-- ── Personal info state ────────────────────────────────────────── -->
<let/infoName=(user?.name ?? "") as string>
<let/infoEmail=(user?.email ?? "") as string>
<let/infoLoading=false>
<let/infoError="" as string>
<let/infoSuccess=false>

<!-- ── Password state ───────────────────────────────────────────── -->
<let/currentPw="" as string>
<let/newPw="" as string>
<let/confirmPw="" as string>
<let/pwLoading=false>
<let/pwError="" as string>
<let/pwSuccess=false>

<!-- ── Skills state ──────────────────────────────────────────────── -->
<let/skills=(user?.skills ?? []) as { id: number; name: string; learning: boolean; learning_note: string; teaching: boolean; teaching_note: string; doing: boolean; doing_note: string }[]>
<let/editingId=(null as number | null)>
<let/editName="" as string>
<let/editLearning=false as boolean>
<let/editLearningNote="" as string>
<let/editTeaching=false as boolean>
<let/editTeachingNote="" as string>
<let/editDoing=false as boolean>
<let/editDoingNote="" as string>
<let/addingSkill=false>
<let/newSkillName="" as string>
<let/newLearning=false as boolean>
<let/newLearningNote="" as string>
<let/newTeaching=false as boolean>
<let/newTeachingNote="" as string>
<let/newDoing=false as boolean>
<let/newDoingNote="" as string>
<let/skillError="" as string>

<!-- ── Helpers ───────────────────────────────────────────────────── -->
<const/showInfoSuccess=() => {
  infoSuccess = true;
  setTimeout(() => { infoSuccess = false; }, 3000);
}>

<const/showPwSuccess=() => {
  pwSuccess = true;
  setTimeout(() => { pwSuccess = false; }, 3000);
}>


<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="page">
  <header class="page-header">
    <h1>${t("profile.title")}</h1>
  </header>

  <!-- ── Personal Information ──────────────────────────────────── -->
  <section class="card">
    <h2 class="section-title">${t("profile.personalInfo")}</h2>

    <form
      class="form"
      onSubmit(e) {
        e.preventDefault();
        infoLoading = true;
        infoError = "";
        fetch("/api/profile", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name: infoName.trim(), email: infoEmail.trim() }),
        })
          .then((r) => r.json())
          .then((d: any) => {
            infoLoading = false;
            if (d.error) {
              infoError = d.error === "Email already in use"
                ? t("profile.emailTaken")
                : d.error;
            } else {
              showInfoSuccess();
            }
          })
          .catch(() => {
            infoError = t("profile.error");
            infoLoading = false;
          });
      }
    >
      <if=infoError>
        <div class="error-banner">${infoError}</div>
      </if>
      <if=infoSuccess>
        <div class="success-banner">${t("profile.infoSaved")}</div>
      </if>

      <div class="field">
        <label for="info-name">${t("profile.name")}</label>
        <input
          id="info-name"
          type="text"
          required
          value=infoName
          onInput(e) { infoName = (e.target as HTMLInputElement).value; }
        />
      </div>

      <div class="field">
        <label for="info-email">${t("profile.email")}</label>
        <input
          id="info-email"
          type="email"
          required
          value=infoEmail
          onInput(e) { infoEmail = (e.target as HTMLInputElement).value; }
        />
      </div>

      <div class="form-footer">
        <button type="submit" class="btn-primary" disabled=infoLoading>
          ${infoLoading ? t("profile.saving") : t("profile.saveInfo")}
        </button>
      </div>
    </form>
  </section>

  <!-- ── Change Password ───────────────────────────────────────── -->
  <section class="card">
    <h2 class="section-title">${t("profile.changePassword")}</h2>

    <form
      class="form"
      onSubmit(e) {
        e.preventDefault();
        if (newPw !== confirmPw) { pwError = t("profile.passwordMismatch"); return; }
        if (newPw.length < 6) { pwError = t("profile.passwordTooShort"); return; }
        pwLoading = true;
        pwError = "";
        fetch("/api/profile/password", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ currentPassword: currentPw, newPassword: newPw }),
        })
          .then((r) => r.json())
          .then((d: any) => {
            pwLoading = false;
            if (d.error) {
              pwError = d.error === "Current password is incorrect"
                ? t("profile.wrongPassword")
                : d.error;
            } else {
              currentPw = "";
              newPw = "";
              confirmPw = "";
              showPwSuccess();
            }
          })
          .catch(() => {
            pwError = t("profile.error");
            pwLoading = false;
          });
      }
    >
      <if=pwError>
        <div class="error-banner">${pwError}</div>
      </if>
      <if=pwSuccess>
        <div class="success-banner">${t("profile.passwordSaved")}</div>
      </if>

      <div class="field">
        <label for="current-pw">${t("profile.currentPassword")}</label>
        <input
          id="current-pw"
          type="password"
          required
          value=currentPw
          onInput(e) { currentPw = (e.target as HTMLInputElement).value; }
        />
      </div>

      <div class="field">
        <label for="new-pw">${t("profile.newPassword")}</label>
        <input
          id="new-pw"
          type="password"
          required
          value=newPw
          onInput(e) { newPw = (e.target as HTMLInputElement).value; }
        />
      </div>

      <div class="field">
        <label for="confirm-pw">${t("profile.confirmPassword")}</label>
        <input
          id="confirm-pw"
          type="password"
          required
          value=confirmPw
          onInput(e) { confirmPw = (e.target as HTMLInputElement).value; }
        />
      </div>

      <div class="form-footer">
        <button type="submit" class="btn-primary" disabled=pwLoading>
          ${pwLoading ? t("profile.savingPassword") : t("profile.savePassword")}
        </button>
      </div>
    </form>
  </section>

  <!-- ── Achievements ─────────────────────────────────────────── -->
  <section class="card">
    <h2 class="section-title">${t("badges.sectionTitle")}</h2>
    <div class="badges-grid">
      <for|def| of=BADGE_DEFS>
        <const/badge=badgeValues.find((b) => b.id === def.id)>
        <const/value=badge?.value ?? 0>
        <const/tier=badge?.tier ?? "none">
        <div class=`badge-card tier-${tier}`>
          <div class="badge-icon-wrap">
            <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d=def.icon/>
            </svg>
          </div>
          <div class="badge-body">
            <div class="badge-top">
              <span class="badge-name">${t(def.nameKey)}</span>
              <span class=`badge-tier-pill tier-pill-${tier}`>${t(`badges.tier.${tier}`)}</span>
            </div>
            <span class="badge-value">${value}</span>
            <p class="badge-desc">${t(def.descKey)}</p>
          </div>
        </div>
      </for>
    </div>
  </section>

  <!-- ── Activities ───────────────────────────────────────────── -->
  <section class="card">
    <h2 class="section-title">${t("profile.skills")}</h2>

    <if=skillError>
      <div class="error-banner">${skillError}</div>
    </if>

    <if=skills.length === 0 && !addingSkill>
      <p class="empty-text">${t("profile.noSkills")}</p>
    </if>

    <div class="skill-list">
      <for|skill| of=skills>
        <if=editingId === skill.id>
          <!-- Edit form -->
          <div class="activity-edit-block">
            <input
              type="text"
              value=editName
              class="skill-name-input"
              onInput(e) { editName = (e.target as HTMLInputElement).value; }
            />

            <div class="options-section">
              <span class="options-label">${t("skills.relatedOptions")}</span>

              <div class="option-group">
                <label class="option-check">
                  <input
                    type="checkbox"
                    checked=editLearning
                    onChange(e) { editLearning = (e.target as HTMLInputElement).checked; }
                  />
                  ${t("skills.learning")}
                </label>
                <if=editLearning>
                  <textarea
                    class="option-note"
                    placeholder=t("skills.notePlaceholder")
                    onInput(e) { editLearningNote = (e.target as HTMLTextAreaElement).value; }
                  >${editLearningNote}</textarea>
                </if>
              </div>

              <div class="option-group">
                <label class="option-check">
                  <input
                    type="checkbox"
                    checked=editTeaching
                    onChange(e) { editTeaching = (e.target as HTMLInputElement).checked; }
                  />
                  ${t("skills.teaching")}
                </label>
                <if=editTeaching>
                  <textarea
                    class="option-note"
                    placeholder=t("skills.notePlaceholder")
                    onInput(e) { editTeachingNote = (e.target as HTMLTextAreaElement).value; }
                  >${editTeachingNote}</textarea>
                </if>
              </div>

              <div class="option-group">
                <label class="option-check">
                  <input
                    type="checkbox"
                    checked=editDoing
                    onChange(e) { editDoing = (e.target as HTMLInputElement).checked; }
                  />
                  ${t("skills.doing")}
                </label>
                <if=editDoing>
                  <textarea
                    class="option-note"
                    placeholder=t("skills.notePlaceholder")
                    onInput(e) { editDoingNote = (e.target as HTMLTextAreaElement).value; }
                  >${editDoingNote}</textarea>
                </if>
              </div>
            </div>

            <div class="edit-footer">
              <button
                type="button"
                class="btn-save"
                onClick() {
                  const name = editName.trim();
                  if (!name) return;
                  fetch(`/api/profile/skills/${skill.id}`, {
                    method: "PATCH",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                      name,
                      learning: editLearning, learning_note: editLearningNote,
                      teaching: editTeaching, teaching_note: editTeachingNote,
                      doing: editDoing, doing_note: editDoingNote,
                    }),
                  })
                    .then((r) => r.json())
                    .then((d: any) => {
                      if (d.error) { skillError = d.error; return; }
                      skills = skills.map((s) =>
                        s.id === skill.id ? { ...s, name: d.name, learning: d.learning, learning_note: d.learning_note, teaching: d.teaching, teaching_note: d.teaching_note, doing: d.doing, doing_note: d.doing_note } : s
                      );
                      editingId = null;
                      skillError = "";
                    })
                    .catch(() => { skillError = t("profile.error"); });
                }
              >
                ${t("profile.save")}
              </button>
              <button
                type="button"
                class="btn-cancel"
                onClick() { editingId = null; }
              >
                ${t("profile.cancel")}
              </button>
            </div>
          </div>
        </if>
        <else>
          <!-- Display row -->
          <div class="activity-row">
            <div class="activity-info">
              <span class="activity-name">${skill.name}</span>
              <if=skill.learning || skill.teaching || skill.doing>
                <div class="activity-opts">
                  <if=skill.learning>
                    <span class="opt-tag">${t("skills.learning")}</span>
                    <if=skill.learning_note>
                      <span class="opt-note">${skill.learning_note}</span>
                    </if>
                  </if>
                  <if=skill.teaching>
                    <span class="opt-tag">${t("skills.teaching")}</span>
                    <if=skill.teaching_note>
                      <span class="opt-note">${skill.teaching_note}</span>
                    </if>
                  </if>
                  <if=skill.doing>
                    <span class="opt-tag">${t("skills.doing")}</span>
                    <if=skill.doing_note>
                      <span class="opt-note">${skill.doing_note}</span>
                    </if>
                  </if>
                </div>
              </if>
            </div>
            <div class="skill-actions">
              <button
                type="button"
                class="btn-sm btn-edit"
                onClick() {
                  editingId = skill.id;
                  editName = skill.name;
                  editLearning = skill.learning;
                  editLearningNote = skill.learning_note;
                  editTeaching = skill.teaching;
                  editTeachingNote = skill.teaching_note;
                  editDoing = skill.doing;
                  editDoingNote = skill.doing_note;
                  addingSkill = false;
                }
              >
                ${t("profile.edit")}
              </button>
              <button
                type="button"
                class="btn-sm btn-del"
                onClick() {
                  if (confirm(t("profile.confirmRemoveSkill", { name: skill.name }))) {
                    fetch(`/api/profile/skills/${skill.id}`, { method: "DELETE" })
                      .then((r) => r.json())
                      .then((d: any) => {
                        if (d.error) { skillError = d.error; return; }
                        skills = skills.filter((s) => s.id !== skill.id);
                        skillError = "";
                      })
                      .catch(() => { skillError = t("profile.error"); });
                  }
                }
              >
                ${t("profile.remove")}
              </button>
            </div>
          </div>
        </else>
      </for>
    </div>

    <if=addingSkill>
      <!-- Add form -->
      <div class="activity-edit-block add-block">
        <input
          type="text"
          placeholder=t("skills.placeholder")
          value=newSkillName
          class="skill-name-input"
          onInput(e) { newSkillName = (e.target as HTMLInputElement).value; }
        />

        <div class="options-section">
          <span class="options-label">${t("skills.relatedOptions")}</span>

          <div class="option-group">
            <label class="option-check">
              <input
                type="checkbox"
                checked=newLearning
                onChange(e) { newLearning = (e.target as HTMLInputElement).checked; }
              />
              ${t("skills.learning")}
            </label>
            <if=newLearning>
              <textarea
                class="option-note"
                placeholder=t("skills.notePlaceholder")
                onInput(e) { newLearningNote = (e.target as HTMLTextAreaElement).value; }
              >${newLearningNote}</textarea>
            </if>
          </div>

          <div class="option-group">
            <label class="option-check">
              <input
                type="checkbox"
                checked=newTeaching
                onChange(e) { newTeaching = (e.target as HTMLInputElement).checked; }
              />
              ${t("skills.teaching")}
            </label>
            <if=newTeaching>
              <textarea
                class="option-note"
                placeholder=t("skills.notePlaceholder")
                onInput(e) { newTeachingNote = (e.target as HTMLTextAreaElement).value; }
              >${newTeachingNote}</textarea>
            </if>
          </div>

          <div class="option-group">
            <label class="option-check">
              <input
                type="checkbox"
                checked=newDoing
                onChange(e) { newDoing = (e.target as HTMLInputElement).checked; }
              />
              ${t("skills.doing")}
            </label>
            <if=newDoing>
              <textarea
                class="option-note"
                placeholder=t("skills.notePlaceholder")
                onInput(e) { newDoingNote = (e.target as HTMLTextAreaElement).value; }
              >${newDoingNote}</textarea>
            </if>
          </div>
        </div>

        <div class="edit-footer">
          <button
            type="button"
            class="btn-save"
            onClick() {
              const name = newSkillName.trim();
              if (!name) return;
              fetch("/api/profile/skills", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  name,
                  learning: newLearning, learning_note: newLearningNote,
                  teaching: newTeaching, teaching_note: newTeachingNote,
                  doing: newDoing, doing_note: newDoingNote,
                }),
              })
                .then((r) => r.json())
                .then((d: any) => {
                  if (d.error) { skillError = d.error; return; }
                  skills = [...skills, d];
                  addingSkill = false;
                  newSkillName = "";
                  newLearning = false; newLearningNote = "";
                  newTeaching = false; newTeachingNote = "";
                  newDoing = false; newDoingNote = "";
                  skillError = "";
                })
                .catch(() => { skillError = t("profile.error"); });
            }
          >
            ${t("profile.saveSkill")}
          </button>
          <button
            type="button"
            class="btn-cancel"
            onClick() {
              addingSkill = false;
              newSkillName = "";
              newLearning = false; newLearningNote = "";
              newTeaching = false; newTeachingNote = "";
              newDoing = false; newDoingNote = "";
            }
          >
            ${t("profile.cancel")}
          </button>
        </div>
      </div>
    </if>

    <if=!addingSkill>
      <button
        type="button"
        class="btn-add-skill"
        onClick() { addingSkill = true; editingId = null; }
      >
        ${t("profile.addSkill")}
      </button>
    </if>
  </section>
</div>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    margin: 0;
    font-size: 1.6rem;
    color: var(--text);
  }

  /* ── Cards ───────────────────────────────────────────────────── */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    transition: background 0.2s, border-color 0.2s;
  }

  .section-title {
    margin: 0 0 1.25rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  /* ── Forms ───────────────────────────────────────────────────── */
  .form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  input[type="text"],
  input[type="email"],
  input[type="password"],
  select {
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    padding: 0.6rem 0.8rem;
    font-size: 0.95rem;
    width: 100%;
    box-sizing: border-box;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  input:focus,
  select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .form-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.25rem;
  }

  /* ── Buttons ─────────────────────────────────────────────────── */
  .btn-primary {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.55rem 1.25rem;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.15s;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--accent-hover);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* ── Feedback banners ────────────────────────────────────────── */
  .error-banner {
    background: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error-text);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    font-size: 0.875rem;
  }

  .success-banner {
    background: color-mix(in srgb, var(--skill-beginner) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--skill-beginner) 40%, transparent);
    color: var(--skill-beginner);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    font-size: 0.875rem;
  }

  /* ── Activities section ──────────────────────────────────────── */
  .empty-text {
    margin: 0 0 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .activity-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .activity-row:last-child {
    border-bottom: none;
  }

  .activity-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .activity-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }

  .activity-opts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
  }

  .opt-tag {
    display: inline-block;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .opt-note {
    font-size: 0.78rem;
    color: var(--text-muted);
