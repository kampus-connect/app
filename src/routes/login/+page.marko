<const/tr=($global as any).translations ?? {}>
<const/t=(key: string, params?: Record<string, string>): string => {
  const dot = key.indexOf(".");
  const s = key.slice(0, dot);
  const k = key.slice(dot + 1);
  let v: string = (tr[s] as Record<string, string>)?.[k] ?? key;
  if (params) for (const [p, r] of Object.entries(params)) v = v.replaceAll(`{${p}}`, r);
  return v;
}>

<let/email=""/>
<let/password=""/>
<let/errorMsg=""/>
<let/loading=false/>

<div class="auth-page">
  <div class="auth-card">
    <h1>${t("login.title")}</h1>
    <p class="sub">${t("login.subtitle")}</p>

    <if=errorMsg>
      <div class="error-banner">${errorMsg}</div>
    </if>

    <form
      class="form"
      onSubmit(e) {
        e.preventDefault();
        loading = true;
        errorMsg = "";
        fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email.trim(), password }),
        })
          .then((r) => r.json())
          .then((data: any) => {
            if (data.error) {
              errorMsg = data.error;
              loading = false;
            } else {
              window.location.href = "/dashboard";
            }
          })
          .catch(() => {
            errorMsg = t("login.error");
            loading = false;
          });
      }
    >
      <div class="field">
        <label for="email">${t("login.email")}</label>
        <input
          id="email"
          type="email"
          placeholder="alice@example.com"
          value=email
          required
          onInput(e) { email = (e.target as HTMLInputElement).value }
        />
      </div>

      <div class="field">
        <label for="password">${t("login.password")}</label>
        <input
          id="password"
          type="password"
          placeholder="••••••••"
          value=password
          required
          onInput(e) { password = (e.target as HTMLInputElement).value }
        />
      </div>

      <button type="submit" class="btn-primary" disabled=loading>
        ${loading ? t("login.submitting") : t("login.submit")}
      </button>
    </form>

    <p class="switch-link">
      ${t("login.noAccount")} <a href="/register">${t("login.createOne")}</a>
    </p>
  </div>
</div>

<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .auth-card {
    width: 100%;
    max-width: 420px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 2rem 2rem 1.75rem;
    transition: background 0.2s, border-color 0.2s;
  }

  h1 {
    margin: 0 0 0.25rem;
    font-size: 1.5rem;
    color: var(--text);
  }

  .sub {
    margin: 0 0 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .error-banner {
    background: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error-text);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  input {
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    padding: 0.6rem 0.8rem;
    font-size: 0.95rem;
    width: 100%;
    box-sizing: border-box;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.65rem;
    font-size: 1rem;
    cursor: pointer;
    width: 100%;
    margin-top: 0.25rem;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--accent-hover);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .switch-link {
    margin: 1.25rem 0 0;
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .switch-link a {
    color: var(--text-link);
    text-decoration: none;
  }

  .switch-link a:hover {
    text-decoration: underline;
  }
</style>
