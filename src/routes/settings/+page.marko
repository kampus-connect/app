<const/tr=($global as any).translations ?? {}>
<const/t=(key: string): string => {
  const dot = key.indexOf(".");
  const s = key.slice(0, dot);
  const k = key.slice(dot + 1);
  return (tr[s] as Record<string, string>)?.[k] ?? key;
}>

<let/theme="dark" as string>
<let/motif="none" as string>
<let/locale=($global as any).locale ?? "pl" as string>

<lifecycle
  onMount() {
    theme = localStorage.getItem("kc-theme") || "dark";
    motif = localStorage.getItem("kc-motif") || "none";
  }
/>

<const/applyTheme=(val: string) => {
  theme = val;
  localStorage.setItem("kc-theme", val);
  document.documentElement.setAttribute("data-theme", val);
}>

<const/applyMotif=(val: string) => {
  motif = val;
  localStorage.setItem("kc-motif", val);
  document.documentElement.setAttribute("data-motif", val);
  window.dispatchEvent(new CustomEvent("kc-motif-change", { detail: { motif: val } }));
}>

<const/applyLang=(lang: string) => {
  fetch("/api/lang", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ lang }),
  }).then(() => window.location.reload());
}>

<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="page">
  <header class="page-header">
    <h1>${t("settings.title")}</h1>
  </header>

  <!-- ── Appearance ────────────────────────────────────────────── -->
  <section class="card">
    <h2 class="section-title">${t("settings.appearance")}</h2>

    <!-- Theme -->
    <div class="setting-row">
      <div class="setting-info">
        <svg class="setting-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <if=theme === "dark">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </if>
          <else>
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </else>
        </svg>
        <div>
          <div class="setting-label">${t("settings.theme")}</div>
          <div class="setting-desc">${t("settings.themeDesc")}</div>
        </div>
      </div>
      <div class="toggle-group">
        <button
          class=`toggle-btn ${theme === "dark" ? "active" : ""}`
          onClick() { applyTheme("dark"); }
        >
          ${t("nav.dark")}
        </button>
        <button
          class=`toggle-btn ${theme === "bright" ? "active" : ""}`
          onClick() { applyTheme("bright"); }
        >
          ${t("nav.bright")}
        </button>
      </div>
    </div>

    <div class="divider"/>

    <!-- Motif -->
    <div class="setting-row">
      <div class="setting-info">
        <svg class="setting-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/>
          <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
        </svg>
        <div>
          <div class="setting-label">${t("settings.motif")}</div>
          <div class="setting-desc">${t("settings.motifDesc")}</div>
        </div>
      </div>
      <div class="toggle-group">
        <button
          class=`toggle-btn ${motif === "none" ? "active" : ""}`
          onClick() { applyMotif("none"); }
        >
          ${t("nav.none")}
        </button>
        <button
          class=`toggle-btn ${motif === "plant" ? "active" : ""}`
          onClick() { applyMotif("plant"); }
        >
          ${t("nav.plant")}
        </button>
      </div>
    </div>
  </section>

  <!-- ── Language ──────────────────────────────────────────────── -->
  <section class="card">
    <h2 class="section-title">${t("settings.language")}</h2>

    <div class="setting-row">
      <div class="setting-info">
        <svg class="setting-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zM2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        <div>
          <div class="setting-label">${t("settings.interfaceLang")}</div>
          <div class="setting-desc">${t("settings.interfaceLangDesc")}</div>
        </div>
      </div>
      <div class="toggle-group">
        <button
          class=`toggle-btn ${locale === "pl" ? "active" : ""}`
          onClick() { applyLang("pl"); }
        >
          ${t("lang.pl")}
        </button>
        <button
          class=`toggle-btn ${locale === "en" ? "active" : ""}`
          onClick() { applyLang("en"); }
        >
          ${t("lang.en")}
        </button>
      </div>
    </div>
  </section>
</div>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    margin: 0;
    font-size: 1.6rem;
    color: var(--text);
  }

  /* ── Card ─────────────────────────────────────────────────────── */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    transition: background 0.2s, border-color 0.2s;
  }

  .section-title {
    margin: 0 0 1.25rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  /* ── Setting row ──────────────────────────────────────────────── */
  .setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .setting-info {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .setting-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .setting-label {
    font-size: 0.9rem;
    color: var(--text);
    font-weight: 500;
    white-space: nowrap;
  }

  .setting-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  .divider {
    height: 1px;
    background: var(--border);
    margin: 1.1rem 0;
  }

  /* ── Toggle group ─────────────────────────────────────────────── */
  .toggle-group {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .toggle-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 8px;
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .toggle-btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .toggle-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
</style>
