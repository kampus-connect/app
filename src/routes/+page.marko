<style>
  /* ── Reset / base ────────────────────────────────────────────── */
  .lp {
    --c-bg:       #15151e;
    --c-surface:  #1e1e2e;
    --c-border:   #2e2e3e;
    --c-primary:  #7c6af6;
    --c-primary-h:#6a59e0;
    --c-accent:   #c4b5fd;
    --c-text:     #fff;
    --c-muted:    #888;
    --c-dim:      #555;
    --r-max:      1120px;

    width: 100%;
    color: var(--c-text);
    background: var(--c-bg);
  }

  /* ── Shared buttons ──────────────────────────────────────────── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--c-primary);
    color: #fff;
    border: 1.5px solid var(--c-primary);
    border-radius: 10px;
    padding: 0.55rem 1.15rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .btn-primary:hover {
    background: var(--c-primary-h);
    border-color: var(--c-primary-h);
    color: #fff;
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: var(--c-muted);
    border: 1.5px solid var(--c-border);
    border-radius: 10px;
    padding: 0.55rem 1.15rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .btn-ghost:hover {
    border-color: #4e4e6e;
    color: #ccc;
  }
  .btn-lg {
    padding: 0.7rem 1.5rem;
    font-size: 1rem;
    border-radius: 12px;
  }
  .btn-xl {
    padding: 0.85rem 2rem;
    font-size: 1.05rem;
    border-radius: 12px;
  }

  /* ── Top banner ──────────────────────────────────────────────── */
  .top-banner {
    width: 100%;
    background: #1a1630;
    border-bottom: 1px solid #2e2e3e;
    text-align: center;
    padding: 0.55rem 1rem;
    font-size: 0.82rem;
    color: var(--c-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }
  .banner-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #34d399;
    flex-shrink: 0;
    animation: pulse-dot 2s infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }
  .banner-link {
    color: var(--c-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .banner-link:hover { text-decoration: underline; }

  /* ── Nav ─────────────────────────────────────────────────────── */
  .lp-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(21, 21, 30, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-border);
  }
  .lp-nav-inner {
    max-width: var(--r-max);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .lp-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    color: #fff;
    flex-shrink: 0;
  }
  .lp-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lp-link {
    color: var(--c-muted);
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    transition: color 0.15s;
  }
  .lp-link:hover { color: #fff; }

  /* ── Hero ────────────────────────────────────────────────────── */
