<const/tr=($global as any).translations ?? {}>
<const/t=(key: string, params?: Record<string, string>): string => {
  const dot = key.indexOf(".");
  const s = key.slice(0, dot);
  const k = key.slice(dot + 1);
  let v: string = (tr[s] as Record<string, string>)?.[k] ?? key;
  if (params) for (const [p, r] of Object.entries(params)) v = v.replaceAll(`{${p}}`, r);
  return v;
}>

<const/currentUserId=($global as any).currentUserId as number>
<const/allSkillNames=(($global as any).allSkillNames ?? []) as string[]>

<!-- ── Initiatives state ──────────────────────────────────────── -->
<let/initiatives=(($global as any).initiatives ?? []) as {
  id: number; title: string; description: string; max_users: number;
  created_by: number; active: boolean; created_at: string;
  skills: string[]; participant_count: number; is_participant: boolean;
}[]>

<!-- ── Create form state ─────────────────────────────────────── -->
<let/creating=false>
<let/formTitle="" as string>
<let/formDesc="" as string>
<let/formMax=5 as number>
<let/formSkills=([] as string[])>
<let/formError="" as string>
<let/formLoading=false>

<const/resetForm=() => {
  formTitle = ""; formDesc = ""; formMax = 5; formSkills = []; formError = ""; formLoading = false;
}>

<const/toggleSkill=(name: string) => {
  formSkills = formSkills.includes(name)
    ? formSkills.filter((s) => s !== name)
    : [...formSkills, name];
}>

<div class="page">
  <header class="page-header">
    <h1>${t("initiatives.title")}</h1>
    <if=!creating>
      <button class="btn-primary" onClick() { creating = true; }>
        ${t("initiatives.create")}
      </button>
    </if>
  </header>

  <!-- ── Create form ───────────────────────────────────────────── -->
  <if=creating>
    <div class="create-card">
      <if=formError>
        <div class="error-banner">${formError}</div>
      </if>

      <div class="form-grid">
        <div class="field">
          <label>${t("initiatives.titleLabel")}</label>
          <input
            type="text"
            value=formTitle
            onInput(e) { formTitle = (e.target as HTMLInputElement).value; }
          />
        </div>

        <div class="field">
          <label>${t("initiatives.descriptionLabel")}</label>
          <textarea
            rows=3
            onInput(e) { formDesc = (e.target as HTMLTextAreaElement).value; }
          >${formDesc}</textarea>
        </div>

        <div class="field field-narrow">
          <label>${t("initiatives.maxUsers")}</label>
          <input
            type="number"
            min=2
            max=100
            value=formMax
            onInput(e) { formMax = parseInt((e.target as HTMLInputElement).value, 10) || 2; }
          />
        </div>

        <if=allSkillNames.length>
          <div class="field">
            <label>${t("initiatives.relatedActivities")}</label>
            <div class="skill-picker">
              <for|name| of=allSkillNames>
                <button
                  type="button"
                  class=`skill-chip ${formSkills.includes(name) ? "is-selected" : ""}`
                  onClick() { toggleSkill(name); }
                >
                  ${name}
                </button>
              </for>
            </div>
          </div>
        </if>
      </div>

      <div class="form-footer">
        <button
          class="btn-primary"
          disabled=formLoading
          onClick() {
            const title = formTitle.trim();
            const desc = formDesc.trim();
            if (!title || !desc) { formError = t("initiatives.error"); return; }
            formLoading = true;
            formError = "";
            fetch("/api/initiatives", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ title, description: desc, max_users: formMax, skills: formSkills }),
            })
              .then((r) => r.json())
              .then((d: any) => {
                formLoading = false;
                if (d.error) { formError = d.error; return; }
                initiatives = [d, ...initiatives];
                creating = false;
                resetForm();
              })
              .catch(() => { formError = t("initiatives.error"); formLoading = false; });
          }
        >
          ${formLoading ? t("initiatives.saving") : t("initiatives.save")}
        </button>
        <button
          class="btn-cancel"
          onClick() { creating = false; resetForm(); }
        >
          ${t("initiatives.cancel")}
        </button>
      </div>
    </div>
  </if>

  <!-- ── Initiative cards ──────────────────────────────────────── -->
  <if=initiatives.length === 0>
    <div class="empty-state">
      <p>${t("initiatives.noActive")}</p>
    </div>
  </if>
  <else>
    <div class="initiatives-grid">
      <for|init| of=initiatives>
        <div class=`initiative-card ${!init.active ? "is-completed" : ""}`>
          <div class="init-header">
            <h2 class="init-title">${init.title}</h2>
            <if=init.created_by === currentUserId>
              <span class="yours-badge">${t("initiatives.yourOwn")}</span>
            </if>
          </div>

          <p class="init-desc">${init.description}</p>

          <if=init.skills.length>
            <div class="init-skills">
              <for|s| of=init.skills>
                <span class="skill-tag">${s}</span>
              </for>
            </div>
          </if>

          <div class="init-footer">
            <div class="participant-bar">
              <div
                class="participant-fill"
                style=`width: ${Math.min(100, Math.round(init.participant_count / init.max_users * 100))}%`
              />
            </div>
            <span class="participant-count">
              ${t("initiatives.participants", { count: String(init.participant_count), max: String(init.max_users) })}
            </span>
          </div>

          <if=init.active>
            <if=init.is_participant>
              <button
                class="btn-joined"
                onClick() {
                  fetch(`/api/initiatives/${init.id}/join`, { method: "DELETE" })
                    .then((r) => r.json())
                    .then((d: any) => {
                      if (d.error) return;
                      initiatives = initiatives.map((i) =>
                        i.id === init.id
                          ? { ...i, is_participant: false, participant_count: i.participant_count - 1 }
                          : i
                      );
                    });
                }
              >
                ${t("initiatives.joined")} ✓
              </button>
            </if>
            <else>
              <button
                class="btn-join"
                onClick() {
                  fetch(`/api/initiatives/${init.id}/join`, { method: "POST" })
                    .then((r) => r.json())
                    .then((d: any) => {
                      if (d.error) return;
                      initiatives = initiatives.map((i) =>
                        i.id === init.id ? { ...i, ...d } : i
                      ).filter((i) => i.active);
                    });
                }
              >
                ${t("initiatives.join")}
              </button>
            </else>
          </if>
          <else>
            <span class="completed-badge">${t("initiatives.completed")}</span>
          </else>
        </div>
      </for>
    </div>
  </else>
</div>

<style>
  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  /* ── Header ──────────────────────────────────────────────────── */
  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .page-header h1 {
    margin: 0;
    font-size: 1.6rem;
    color: var(--text);
  }

  /* ── Create form card ────────────────────────────────────────── */
  .create-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .form-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field-narrow {
    max-width: 160px;
  }

  label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  input[type="text"],
  input[type="number"],
  textarea {
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    padding: 0.6rem 0.8rem;
    font-size: 0.95rem;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
    resize: vertical;
    transition: border-color 0.15s;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  /* ── Skill picker ────────────────────────────────────────────── */
  .skill-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-chip {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.8rem;
    padding: 0.2rem 0.65rem;
    cursor: pointer;
    transition: border-color 0.12s, background 0.12s, color 0.12s;
  }

  .skill-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .skill-chip.is-selected {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 500;
  }

  .form-footer {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  /* ── Buttons ─────────────────────────────────────────────────── */
  .btn-primary {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.55rem 1.25rem;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.15s;
    white-space: nowrap;
  }

  .btn-primary:hover:not(:disabled) { background: var(--accent-hover); }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

  .btn-cancel {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 8px;
    padding: 0.55rem 1.25rem;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .btn-cancel:hover { background: var(--surface-hover); color: var(--text); }

  /* ── Initiatives grid ────────────────────────────────────────── */
  .initiatives-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1rem;
  }

  .initiative-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.15s, background 0.15s;
  }

  .initiative-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    background: var(--surface-hover);
  }

  .initiative-card.is-completed {
    opacity: 0.6;
  }

  /* ── Card header ─────────────────────────────────────────────── */
  .init-header {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .init-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    flex: 1;
    line-height: 1.3;
  }

  .yours-badge {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 999px;
    padding: 0.1rem 0.45rem;
    margin-top: 0.1rem;
  }

  /* ── Description ─────────────────────────────────────────────── */
  .init-desc {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Skill tags ──────────────────────────────────────────────── */
  .init-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .skill-tag {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--surface-hover);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }

  /* ── Participant bar ─────────────────────────────────────────── */
  .init-footer {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: auto;
  }

  .participant-bar {
    height: 4px;
    background: var(--border);
    border-radius: 999px;
    overflow: hidden;
  }

  .participant-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  .participant-count {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* ── Join / joined buttons ───────────────────────────────────── */
  .btn-join {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.45rem 1rem;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.15s;
    align-self: flex-start;
  }

  .btn-join:hover { background: var(--accent-hover); }

  .btn-joined {
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent);
    border-radius: 8px;
    padding: 0.45rem 1rem;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    align-self: flex-start;
  }

  .btn-joined:hover {
    background: var(--error-bg);
    border-color: var(--error-border);
    color: var(--error-text);
  }

  .completed-badge {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
  }

  /* ── Banners ─────────────────────────────────────────────────── */
  .error-banner {
    background: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error-text);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
