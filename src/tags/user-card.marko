export interface Input {
  user: {
    id: number;
    name: string;
    email: string;
    roles: string[];
    skills: { id: number; name: string; learning: boolean; learning_note: string; teaching: boolean; teaching_note: string; doing: boolean; doing_note: string }[];
  };
  isAdmin: boolean;
}

<const/tr=($global as any).translations ?? {}>
<const/t=(key: string, params?: Record<string, string>): string => {
  const dot = key.indexOf(".");
  const s = key.slice(0, dot);
  const k = key.slice(dot + 1);
  let v: string = (tr[s] as Record<string, string>)?.[k] ?? key;
  if (params) for (const [p, r] of Object.entries(params)) v = v.replaceAll(`{${p}}`, r);
  return v;
}>

<const/user=input.user>
<const/isAdmin=input.isAdmin>

<div class="user-card">
  <div class="user-meta">
    <h3>${user.name}</h3>
    <span class="email">${user.email}</span>
    <div class="role-badges">
      <for|role| of=user.roles>
        <span class=`role-badge role-${role}`>${role}</span>
      </for>
    </div>
  </div>

  <div class="skills">
    <if=user.skills.length>
      <for|skill| of=user.skills>
        <div class="activity-item">
          <span class="activity-name">${skill.name}</span>
          <if=skill.learning || skill.teaching || skill.doing>
            <div class="activity-opts">
              <if=skill.learning><span class="opt-tag">${t("skills.learning")}</span></if>
              <if=skill.teaching><span class="opt-tag">${t("skills.teaching")}</span></if>
              <if=skill.doing><span class="opt-tag">${t("skills.doing")}</span></if>
            </div>
          </if>
        </div>
      </for>
    </if>
    <else>
      <span class="no-skills">${t("card.noSkills")}</span>
    </else>
  </div>

  <if=isAdmin>
    <div class="admin-actions">
      <if=user.roles.includes("admin")>
        <button
          class="btn-role btn-demote"
          onClick() {
            if (confirm(t("card.confirmRemoveAdmin", { name: user.name }))) {
              fetch(`/api/users/${user.id}/roles`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "remove", role: "admin" }),
              }).then((r) => r.json()).then((d: any) => {
                if (d.error) alert(d.error);
                else window.location.reload();
              });
            }
          }
        >
          ${t("card.removeAdmin")}
        </button>
      </if>
      <else>
        <button
          class="btn-role btn-promote"
          onClick() {
            if (confirm(t("card.confirmMakeAdmin", { name: user.name }))) {
              fetch(`/api/users/${user.id}/roles`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "add", role: "admin" }),
              }).then((r) => r.json()).then((d: any) => {
                if (d.error) alert(d.error);
                else window.location.reload();
              });
            }
          }
        >
          ${t("card.makeAdmin")}
        </button>
      </else>

      <button
        class="btn-delete"
        onClick() {
          if (confirm(t("card.confirmDelete", { name: user.name }))) {
            fetch(`/api/users/${user.id}`, { method: "DELETE" })
              .then(() => window.location.reload());
          }
        }
      >
        ${t("card.delete")}
      </button>
    </div>
  </if>
</div>

